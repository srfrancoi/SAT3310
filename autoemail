dataurl = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vS_JMk76FaCnih6wo71SqHx9BaxOyXJ2F06_Vd6XR88xclXHuH00O40nqRcUNRdGj9uqKt7jv4ItR_m/pub?output=csv'  # URL of the Google Sheets CSV export
datafile = 'the-state-of-michigan-michigan-technological-university-1983807'
