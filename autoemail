outputfile = 'donation_emails.txt'  
mtu_emails = []  # stores emails for MTU
michigan_gov_emails = []  # stores emails for MI.gov
mydebug = True

# Email template the """ allows us to create a multilined string
email_template = """ 
Email Address: {email}

Subject: Donation Request

Dear {firstname} {lastname},

I hope this email finds you well.

We are reaching out to you today to request a donation to support those in need. Your contribution would make a significant impact on a family in need of financial support going through college.

